# NOOIT de echte waarden in GitHub zetten. Deze horen in Supabase (Edge Function secrets) en Vercel (Environment Variables).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publieke anon key, mag in de app>
SUPABASE_SERVICE_ROLE_KEY=<geheim, alleen in Supabase Edge Functions>
ANTHROPIC_API_KEY=<geheim, alleen in Supabase Edge Functions>
ANTHROPIC_MODEL=claude-sonnet-5-5
DOUBLE_READ=1
SAMPLE_RATE=0.2
MIN_CONFIDENCE=0.9
