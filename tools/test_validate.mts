import { decide } from '../supabase/functions/ingest-steps/validate.ts';
const base = { today: '2027-01-19', start: '2027-01-01', days: 31, maxPlausible: 60000, backfillDays: 3, participantSource: 'healthkit' as const };
let fail = 0; const t = (name: string, got: any, want: any) => { const ok = JSON.stringify(got) === JSON.stringify(want); if (!ok) fail++; console.log(ok ? '✓' : '✗', name, ok ? '' : JSON.stringify(got)); };
const d = (o: any, c: any = {}) => { const r: any = decide({ day: '2027-01-18', steps: 12431, source_kind: 'healthkit', ...o }, { ...base, ...c }); return r.accept ? [r.accept, r.status, r.reason] : [r.accept, r.error]; };
t('normaal → ok', d({}), [true, 'ok', null]);
t('handmatig → pending', d({ is_manual: true }), [true, 'pending', 'Handmatig ingevoerd in de gezondheidsapp']);
t('61.000 stappen → pending', d({ steps: 61000 }), [true, 'pending', 'Ongebruikelijk hoog aantal (61000)']);
t('60.000 precies → ok', d({ steps: 60000 }), [true, 'ok', null]);
t('negatief → afgewezen', d({ steps: -5 }), [false, 'Ongeldig aantal stappen']);
t('decimaal → afgewezen', d({ steps: 100.5 }), [false, 'Ongeldig aantal stappen']);
t('toekomst → afgewezen', d({ day: '2027-01-20' }), [false, 'Datum ligt in de toekomst']);
t('voor de start → afgewezen', d({ day: '2026-12-31' }), [false, 'Datum valt buiten de challenge']);
t('na het einde → afgewezen', d({ day: '2027-02-01' }, { today: '2027-02-02' }), [false, 'Datum valt buiten de challenge']);
t('4 dagen terug → afgewezen', d({ day: '2027-01-15' }), [false, 'Te lang geleden: neem contact op met de organisatie']);
t('3 dagen terug → ok', d({ day: '2027-01-16' }), [true, 'ok', null]);
t('andere bron → afgewezen', d({ source_kind: 'garmin' }), [false, 'Bron komt niet overeen met je gekoppelde bron']);
t('screenshot via ingest → afgewezen', d({ source_kind: 'screenshot' }), [false, 'Screenshots lopen via de uploadroute']);
t('door beheerder beoordeeld → blijft staan', d({}, { existing: { status: 'ok', source_kind: 'healthkit', reviewed_by: 'abc', steps: 100 } }), [false, 'Deze dag is al door een beheerder beoordeeld']);
t('daling na afloop → pending', d({ steps: 9000 }, { existing: { status: 'ok', source_kind: 'healthkit', steps: 12431 } }), [true, 'pending', 'Aantal daalde van 12431 naar 9000']);
t('stijging na afloop → ok', d({ steps: 13000 }, { existing: { status: 'ok', source_kind: 'healthkit', steps: 12431 } }), [true, 'ok', null]);
t('vandaag (dag loopt nog) mag dalen/stijgen → ok', d({ day: '2027-01-19', steps: 4000 }, { existing: { status: 'ok', source_kind: 'healthkit', steps: 5000 } }), [true, 'ok', null]);
console.log(fail ? `\n${fail} FOUT` : '\nalle tests geslaagd'); process.exit(fail ? 1 : 0);
