import { inspect, assess } from '../supabase/functions/screenshot-review/forensics.ts';
import { parseRead, review, type Ctx } from '../supabase/functions/screenshot-review/review.ts';
let fail = 0; const t = (n: string, got: any, want: any) => { const ok = JSON.stringify(got) === JSON.stringify(want); if (!ok) fail++; console.log(ok ? '✓' : '✗', n, ok ? '' : '\n    kreeg ' + JSON.stringify(got)); };
const enc = (s: string) => new TextEncoder().encode(s);
const be32 = (n: number) => [n >>> 24 & 255, n >>> 16 & 255, n >>> 8 & 255, n & 255];
const chunk = (type: string, data: Uint8Array) => [...be32(data.length), ...enc(type), ...data, 0, 0, 0, 0];
const png = (w: number, h: number, extra: number[][] = []) => new Uint8Array([0x89, 0x50, 0x4e, 0x47, 13, 10, 26, 10, ...chunk('IHDR', new Uint8Array([...be32(w), ...be32(h), 8, 6, 0, 0, 0])), ...extra.flat(), ...chunk('IDAT', new Uint8Array([1, 2, 3])), ...chunk('IEND', new Uint8Array())]);
const text = (k: string, v: string) => chunk('tEXt', enc(k + '\0' + v));
const jpeg = (w: number, h: number, app1 = '') => { const a = enc(app1), seg = app1 ? [0xff, 0xe1, (a.length + 2) >> 8, (a.length + 2) & 255, ...a] : []; return new Uint8Array([0xff, 0xd8, ...seg, 0xff, 0xc0, 0, 11, 8, h >> 8, h & 255, w >> 8, w & 255, 3, 0, 0, 0xff, 0xda, 0, 2, 9, 9, 0xff, 0xd9]); };
console.log('— bestandsgegevens lezen —');
const iphone = inspect(png(1179, 2556, [text('Software', 'iOS 17.2')]));
t('iPhone-screenshot (PNG 1179×2556)', [iphone.format, iphone.width, iphone.height, iphone.tools], ['png', 1179, 2556, []]);
t('… beoordeling: niets aan de hand', assess(iphone), { risk: 'none', signals: [] });
t('PNG met Photoshop in de metadata', assess(inspect(png(1179, 2556, [text('Software', 'Adobe Photoshop 25.0 (Macintosh)')]))), { risk: 'high', signals: ['Bewerkt of gemaakt met Photoshop'] });
t('PNG met Canva in XMP', assess(inspect(png(1080, 2400, [chunk('iTXt', enc('XML:com.adobe.xmp\0\0\0\0\0<x:xmpmeta><xmp:CreatorTool>Canva</xmp:CreatorTool></x:xmpmeta>'))]))).signals, ['Bewerkt of gemaakt met Canva']);
const ai = inspect(png(1024, 1792, [chunk('caBX', enc('jumb c2pa c2pa.actions digitalSourceType http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia'))]));
t('AI-beeld met Content Credentials', [ai.hasC2PA, ai.c2paAI, assess(ai).risk], [true, true, 'high']);
t('… signaal benoemd', assess(ai).signals[0], 'Content Credentials: (deels) gemaakt met AI');
t('JPG via WhatsApp (staand): één zwak signaal, geen actie', assess(inspect(jpeg(1080, 2340))), { risk: 'low', signals: ['Opnieuw opgeslagen als JPG (bijvoorbeeld via WhatsApp)'] });
t('JPG mét Snapseed in EXIF', assess(inspect(jpeg(1080, 2340, 'Exif\0\0 Software Snapseed 2.0'))).risk, 'high');
t('JPG en bijgesneden (liggend): twee zwakke signalen → mens', assess(inspect(jpeg(1600, 900))).risk, 'high');
t('PNG bijgesneden tot vierkant: één zwak signaal', assess(inspect(png(800, 800))).risk, 'low');
t('JPG-afmetingen goed gelezen', [inspect(jpeg(1080, 2340)).width, inspect(jpeg(1080, 2340)).height], [1080, 2340]);
t('pixeldata wordt niet als metadata gelezen (tekst "photoshop" in IDAT)', inspect(new Uint8Array([...png(1179, 2556).slice(0, 33), ...chunk('IDAT', enc('photoshop')), ...chunk('IEND', new Uint8Array())])).tools, []);
t('onbekend bestand', inspect(enc('hallo')).format, 'other');
console.log('— in de beslissing —');
const good = { is_step_screen: true, steps: 12431, date_iso: '2027-01-18', relative_label: null, app_name: 'Gezondheid', confidence: 0.97, concerns: [], edit_suspected: false, edit_signs: [] };
const base: Ctx = { claimedDay: '2027-01-18', uploadDay: '2027-01-19', maxPlausible: 60000, minConfidence: 0.9, sampleRate: 0, sampleKey: 'k', history: [], duplicate: null, second: null, attempt: 1 };
const v = (o: any, c: Partial<Ctx> = {}) => { const r: any = review(parseRead(JSON.stringify({ ...good, ...o })), { ...base, ...c }); return [r.action, r.reason]; };
t('schoon bestand + schoon beeld → goedgekeurd', v({}, { authenticity: { risk: 'none', signals: [] } }), ['approve', null]);
t('één zwak signaal (WhatsApp) → toch goedgekeurd', v({}, { authenticity: { risk: 'low', signals: ['Opnieuw opgeslagen als JPG'] } }), ['approve', null]);
t('Photoshop in metadata → mens, nooit afkeuren', v({}, { authenticity: { risk: 'high', signals: ['Bewerkt of gemaakt met Photoshop'] } }), ['review', 'Echtheidscontrole: Bewerkt of gemaakt met Photoshop']);
t('model ziet afwijkend lettertype → mens', v({ edit_suspected: true, edit_signs: ['cijfers in ander lettertype'] }), ['review', 'Echtheidscontrole: mogelijk bewerkt of met AI gemaakt (cijfers in ander lettertype)']);
t('verkeerde dag gaat vóór echtheid (deelnemer kan direct opnieuw)', v({ date_iso: '2027-01-17' }, { authenticity: { risk: 'high', signals: ['x'] } })[0], 'retry');
t('oud antwoord zonder edit-velden blijft werken', review(parseRead(JSON.stringify({ is_step_screen: true, steps: 100, date_iso: '2027-01-18', confidence: 0.95, concerns: [] })), base).action, 'approve');
console.log(fail ? `\n${fail} FOUT` : '\nalle tests geslaagd'); process.exit(fail ? 1 : 0);
